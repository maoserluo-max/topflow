# 环境变量配置（复制此文件为 .env 并修改值）
# 复制命令: cp .env.example .env

# JWT密钥（必须修改！生成方法: python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=your-secret-key-change-in-production-2024

# 数据库URL
DATABASE_URL=sqlite:///./data/topflow.db

# CORS允许的来源
CORS_ORIGINS=["http://43.160.238.9","http://localhost:3000","http://127.0.0.1:5173"]

# Token过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440